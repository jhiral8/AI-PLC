      "hash": "sha256:b256f87bdcc34939"
    },
    {
      "id": "FR-002",
      "type": "requirement",
      "title": "Each link MUST record the upstream node's content hash when made or confirmed.",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-002",
      "hash": "sha256:1106d3d7cd404014"
    },
    {
      "id": "FR-003",
