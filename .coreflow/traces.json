    {
      "id": "FR-001",
      "type": "requirement",
      "title": "The system MUST store nodes and links in a versioned JSON trace file in the product repo.",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-001",
      "hash": "sha256:b256f87bdcc34939"
    },
    {
      "id": "FR-002",
      "type": "requirement",
      "title": "Each link MUST record the upstream node's content hash when made or confirmed.",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-002",
      "hash": "sha256:1106d3d7cd404014"
    },
    {
      "id": "FR-003",
      "type": "requirement",
      "title": "The system MUST report suspect nodes with their causes and distance from the cause.",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-003",
      "hash": "sha256:9e0e6323ec41b9a0"
    },
    {
      "id": "FR-004",
      "type": "requirement",
      "title": "Content hashing MUST ignore line-ending and trailing-whitespace differences.",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-004",
      "hash": "sha256:e4f57599066c0db8"
    },
    {
      "id": "FR-005",
      "type": "requirement",
      "title": "The system MUST support explicit change marks with a reason for changes a hash cannot show.",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-005",
      "hash": "sha256:25e39c5504be06a1"
    },
    {
      "id": "FR-006",
      "type": "requirement",
      "title": "The system MUST provide a CLI and an MCP server exposing link, trace, suspect and confirm.",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-006",
      "hash": "sha256:5bbba58ed83ace09"
    },
    {
      "id": "FR-007",
      "type": "requirement",
      "title": "The system MUST ship as a Claude Code plugin and as a Kiro power (Agent Plugins format) sharing o...",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-007",
      "hash": "sha256:790dc74fd4a5d684"
    },
    {
      "id": "FR-008",
      "type": "requirement",
      "title": "Gates MUST check completeness, evidence coverage, freshness, evidence quality and approval, in bl...",
      "location": "specs/006-coreflow-evidence-lifecycle/spec.md#FR-008",
